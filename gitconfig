[color]
    ui = auto
    diff = auto
    status = auto
    branch = auto
[push]
    default = current
[init]
    defaultBranch = main
[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[core]
    hooksPath = ~/.config/git-hooks
# ~/.gitconfig.local (identity + machine-local settings) is included by the
# generated ~/.gitconfig stub, after this file, so its values win. Do not add an
# include for it here too: this file is itself included, and including
# gitconfig.local twice duplicates every multi-valued key (safe.directory etc).
[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --oneline --graph --decorate
    ps = push
    pl = pull
