[color]
    ui = auto
    diff = auto
    status = auto
    branch = auto
[push]
    default = current
[init]
    defaultBranch = main
[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[core]
    hooksPath = ~/.config/git-hooks
# ~/.gitconfig.local (identity + machine-local settings) is included by the
# generated ~/.gitconfig stub, after this file, so its values win. Do not add an
# include for it here too: this file is itself included, and including
# gitconfig.local twice duplicates every multi-valued key (safe.directory etc).
[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --oneline --graph --decorate
    ps = push
    pl = pull
# Strips the harness-generated `autoMode` block from .claude/settings.json on
# the way into git (see .gitattributes). `smudge = cat` is an explicit no-op:
# with `required = true` and no smudge command, git treats checkout itself as
# failing (confirmed — it deletes the working file). `required = true` means
# a missing/broken `jq` makes `clean` fail loudly instead of silently letting
# the block through — jq is already an install.sh/bootstrap.sh dependency.
[filter "claude-settings"]
    clean = jq --indent 2 'del(.autoMode)'
    smudge = cat
    required = true
