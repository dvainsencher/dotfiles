{
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/daniel/.claude/hooks/env-loader.sh"
          },
          {
            "type": "command",
            "command": "/home/daniel/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/daniel/.claude/hooks/check-main-branch.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/daniel/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "theme": "dark-daltonized",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
