# .claude/settings.json is symlinked to ~/.claude/settings.json, and per-session
# state gets written into it: the harness (autoMode.environment: local paths and
# other-repo details), /model (model) and Orca (hook entries). None of that
# belongs in this public repo (same leak class as the gitconfig fix, see
# gitconfig / CLAUDE.md).
# The `claude-settings` clean filter (defined in the tracked `gitconfig`,
# included into ~/.gitconfig by setup-gitconfig.sh) runs .claude/settings-clean.jq
# on the way into git: the live file keeps all of it, git never stores it.
.claude/settings.json filter=claude-settings
